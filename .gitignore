node_modules/
dist/
coverage/
*.tsbuildinfo
.DS_Store
.vite/
test-results/
playwright-report/
blob-report/
.playwright/
tools/bench/fixtures/

# Wrangler's local state and temporary bundles: a real Durable Object's SQLite
# lives here when the room runs locally.
.wrangler/
*.local
.env
.env.*
!.env.example
# Public build configuration, committed deliberately — see the header in the
# file, and `app/env-file.test.ts`, which fails if a secret is added to it.
!apps/web/.env

# Claude Code machine-local settings (holds the impeccable design hook).
.claude/settings.local.json

# impeccable-ignore-start
# Ephemeral output, runtime state, and per-dev overrides.
# Unanchored: .impeccable may sit at the repo root or under a nested
# workspace (apps/web/.impeccable/...); anchored patterns would miss it.
# Shared artifacts stay tracked: config.json, live/config.json,
# design.json, surfaces/*.md, critique/*.md.
.impeccable/config.local.json
.impeccable/hook.cache.json
.impeccable/hook.pending.json
.impeccable/*.png
.impeccable/review/
.impeccable/questions/
.impeccable/live/server.json
.impeccable/live/sessions/
.impeccable/live/previews/
.impeccable/live/annotations/
.impeccable/live/cache/
.impeccable/live/manual-edit-apply-transaction.json
.impeccable/live/manual-edit-events.jsonl
.impeccable/live/manual-edit-evidence/
.impeccable/live/pending-manual-edits.json
.impeccable/live/deferred-svelte-component-accepts.json
.impeccable/live/*.png
# impeccable-ignore-end

# The live server's runtime state, wherever .impeccable sits. The block above
# anchors these to the repo root (a pattern with a slash in it is anchored),
# so a critique run under apps/web left them untracked in every status.
**/.impeccable/live/server.json
**/.impeccable/live/sessions/
**/.impeccable/live/annotations/
