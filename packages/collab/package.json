    "build": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@openframe/core": "workspace:*",
    "lib0": "^0.2.117",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "typescript": "6.0.3",
    "vitest": "^5.0.1"
  }
}
