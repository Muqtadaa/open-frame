{
  "name": "@openframe/core",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "OpenFrame domain, command layer, schema and ports. Pure TypeScript — no React, no DOM, no database, no CRDT.",
  "exports": {
    ".": "./src/index.ts",
    "./geometry": "./src/geometry/index.ts",
    "./domain": "./src/domain/index.ts",
    "./schema": "./src/schema/index.ts",
    "./commands": "./src/commands/index.ts",
    "./ports": "./src/ports/index.ts",
    "./store": "./src/store/index.ts",
    "./types": "./src/types/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "fractional-indexing": "^4.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "typescript": "6.0.3",
    "vitest": "^5.0.1"
  }
}
