{
  "name": "@openframe/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "OpenFrame web client \u2014 canvas renderer, interaction layer, UI shell and adapters.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium",
    "build": "vite build",
    "preview": "vite preview",
    "test:bench": "playwright test --project=bench"
  },
  "dependencies": {
    "@openframe/core": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.2",
    "jsdom": "^28.0.0",
    "typescript": "6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
